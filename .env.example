# Verdict Master — environment configuration
# Copy this file to `.env.local` and fill in your key.

# Required. Your Anthropic API key — used server-side only (never exposed to the browser).
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Override the model used to generate debates and verdicts.
# Defaults to claude-opus-4-8.
# VM_MODEL=claude-opus-4-8
